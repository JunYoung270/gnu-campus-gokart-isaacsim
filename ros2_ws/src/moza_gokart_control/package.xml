<?xml version="1.0"?>
<package format="3">
  <name>moza_gokart_control</name>
  <version>0.1.0</version>
  <description>Fail-safe MOZA R5 manual control pipeline for the KAR GoKart.</description>
  <maintainer email="maintainer@example.com">KAR AI Copilot Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>ackermann_msgs</exec_depend>
  <exec_depend>moza_gokart_interfaces</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
