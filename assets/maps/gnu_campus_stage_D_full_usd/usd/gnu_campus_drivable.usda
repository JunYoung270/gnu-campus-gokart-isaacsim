#usda 1.0
(
    "GNU Campus full-area visual plus static collision; no PhysicsScene or vehicle"
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Xform "GNU_Campus" (
        customData = {
            dictionary gnuCampus = {
                string axis = "X East, Y North, Z Up"
                string coordinateSystem = "right-handed ENU"
                string unit = "metre"
            }
        }
    )
    {
        def Scope "Lighting"
        {
            def DomeLight "Dome"
            {
                float inputs:intensity = 1000
            }

            def DistantLight "Sun"
            {
                float inputs:angle = 0.8
                float inputs:intensity = 3000
                float3 xformOp:rotateXYZ = (45, -35, -30)
                uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
            }
        }

        def Scope "Visual"
        {
            def Xform "Terrain" (
                customData = {
                    dictionary gnuCampus = {
                        string axisCorrection = "RotateX(+90deg)"
                        string sourceAsset = "terrain_visual.glb"
                    }
                }
                prepend references = @components/terrain_visual.usd@</World>
            )
            {
                float xformOp:rotateX:gltfPayloadToENU = 90
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale", "xformOp:rotateX:gltfPayloadToENU"]
            }

            def Xform "Road" (
                customData = {
                    dictionary gnuCampus = {
                        string axisCorrection = "RotateX(+90deg)"
                        string sourceAsset = "road_visual.glb"
                    }
                }
                prepend references = @components/road_visual.usd@</World>
            )
            {
                float xformOp:rotateX:gltfPayloadToENU = 90
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale", "xformOp:rotateX:gltfPayloadToENU"]
            }

            def Xform "Buildings" (
                customData = {
                    dictionary gnuCampus = {
                        string axisCorrection = "RotateX(+90deg)"
                        string sourceAsset = "buildings_visual.glb"
                    }
                }
                prepend references = @components/buildings_visual.usd@</World>
            )
            {
                float xformOp:rotateX:gltfPayloadToENU = 90
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale", "xformOp:rotateX:gltfPayloadToENU"]
            }

            def Xform "Sidewalk" (
                customData = {
                    dictionary gnuCampus = {
                        string axisCorrection = "RotateX(+90deg)"
                        string sourceAsset = "sidewalk_visual.glb"
                    }
                }
                prepend references = @components/sidewalk_visual.usd@</World>
            )
            {
                float xformOp:rotateX:gltfPayloadToENU = 90
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale", "xformOp:rotateX:gltfPayloadToENU"]
            }
        }

        def Xform "Collision" (
            customData = {
                dictionary gnuCampus = {
                    bool renderHiddenCollision = 1
                }
            }
        )
        {
            token visibility = "invisible"

            def Xform "Terrain" (
                customData = {
                    dictionary gnuCampus = {
                        string axisCorrection = "RotateX(+90deg)"
                        string sourceAsset = "terrain_collision_source.glb"
                    }
                }
                prepend references = @components/terrain_collision_source.usd@</World>
            )
            {
                float xformOp:rotateX:gltfPayloadToENU = 90
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale", "xformOp:rotateX:gltfPayloadToENU"]

                over "terrain_collision_source" (
                    prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
                )
                {
                    rel material:binding:physics = </World/GNU_Campus/PhysicsMaterials/GrassPhysicsMaterial> (
                        bindMaterialAs = "weakerThanDescendants"
                    )
                    uniform token physics:approximation = "none"
                    bool physics:collisionEnabled = 1
                }
            }

            def Xform "Road" (
                customData = {
                    dictionary gnuCampus = {
                        string axisCorrection = "RotateX(+90deg)"
                        string sourceAsset = "road_collision_source.glb"
                    }
                }
                prepend references = @components/road_collision_source.usd@</World>
            )
            {
                float xformOp:rotateX:gltfPayloadToENU = 90
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale", "xformOp:rotateX:gltfPayloadToENU"]

                over "road_collision_source" (
                    prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
                )
                {
                    rel material:binding:physics = </World/GNU_Campus/PhysicsMaterials/AsphaltPhysicsMaterial> (
                        bindMaterialAs = "weakerThanDescendants"
                    )
                    uniform token physics:approximation = "none"
                    bool physics:collisionEnabled = 1
                }
            }

            def Xform "Buildings" (
                customData = {
                    dictionary gnuCampus = {
                        string axisCorrection = "RotateX(+90deg)"
                        string sourceAsset = "buildings_collision_source.glb"
                    }
                }
