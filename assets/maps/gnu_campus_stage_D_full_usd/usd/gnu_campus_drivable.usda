            {
                float xformOp:rotateX:gltfPayloadToENU = 90
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale", "xformOp:rotateX:gltfPayloadToENU"]

                over "building_collision_115467019_0"
