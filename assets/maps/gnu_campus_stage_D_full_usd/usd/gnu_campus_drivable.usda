        def Scope "PhysicsMaterials" (
            customData = {
                dictionary gnuCampus = {
                    bool physicsOnly = 1
                }
            }
        )
        {
            def Material "GrassPhysicsMaterial" (
                prepend apiSchemas = ["PhysicsMaterialAPI"]
            )
            {
                float physics:dynamicFriction = 0.4
                float physics:restitution = 0
                float physics:staticFriction = 0.6
            }

            def Material "AsphaltPhysicsMaterial" (
                prepend apiSchemas = ["PhysicsMaterialAPI"]
            )
            {
                float physics:dynamicFriction = 0.7
                float physics:restitution = 0
                float physics:staticFriction = 0.9
            }

            def Material "BuildingPhysicsMaterial" (
                prepend apiSchemas = ["PhysicsMaterialAPI"]
            )
            {
                float physics:dynamicFriction = 0.6
                float physics:restitution = 0
                float physics:staticFriction = 0.7
            }
